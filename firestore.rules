rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Reglas de seguridad estrictas para Az Vault:
    // Colección: /users/{userId}/vault/{entryId}
    // Permite lectura, creación, edición y borrado SOLO si el usuario está autenticado y posee el documento.
    // Además, valida que los campos cifrados requeridos (ciphertext, salt, iv) estén presentes al crear o editar.
    match /users/{userId}/vault/{entryId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['ciphertext', 'salt', 'iv'])
        && request.resource.data.ciphertext is string
        && request.resource.data.salt is string
        && request.resource.data.iv is string;
    }
    
    // Bloqueo total defensivo para cualquier otra ruta de la base de datos
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
